generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  requestType String
  status      String
  requestedBy String
  createdAt   DateTime @default(now())

  auditLogs   AuditLog[]
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  requestId   Int
  action      String
  performedBy String
  timestamp   DateTime @default(now())

  request     Request @relation(fields: [requestId], references: [id])
}